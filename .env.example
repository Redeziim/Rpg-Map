# Production only: set these in your hosting environment.
NODE_ENV=production
PUBLIC_ORIGIN=https://rpg.example.com
PORT=3001
HOST=0.0.0.0
DB_PATH=/data/grimorio.sqlite

# Optional automatic backups. Set in the hosting environment; .env is not loaded automatically.
# BACKUP_DIR=/data/automatic-backups
# BACKUP_INTERVAL_MINUTES=1440
# BACKUP_KEEP=14
# BACKUP_RETRY_MINUTES=15
# BACKUP_TIMEOUT_MINUTES=30
